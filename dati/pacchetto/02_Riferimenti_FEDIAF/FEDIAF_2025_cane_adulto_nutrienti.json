    "evaluations": [
      "official minimum: RED if below",
      "official nutritional maximum: RED if above",
      "missing data: GREY / NOT_VERIFIABLE, never zero",
      "undefined official maximum: NO automatic PASS for excess; avoid inventing toxicity threshold",
      "configurable orange: only owner-approved nonofficial caution thresholds; must state NOT_OFFICIAL",
      "informational blue: no normative min/max",
      "special breed purple: attention only, not automatic dose"
    ],
    "daily_conversion": "target_daily = per_1000_kcal * target_kcal_per_day / 1000",
    "product_sums": "sum over product_g * per_100g_nutrient / 100; honor cooking state and conversion",
    "ratios": "Compute from totals in same units; zero denominator -> undefined",
    "completeness": "Not proven if critical input nutrients or essential amino acids unknown",
    "solver": "Hard constraints: validated nutritional requirements & physiological safety; soft: optional personalized targets. Independently re-evaluate solution from complete list incl supplements.",
    "warning_without_upper_bound": "NO invented green-safety claim. Allow an orange signal only if a reviewed user/admin defined heuristic or confirmed contextual safe value; annotate provenance and rationale, never use heuristic as toxicity threshold.",
    "custom_thresholds": "Provide separate editable target objects with source/user,date,unit,basis,review status,hard_or_soft, and optional lower/upper; do not pre-populate arbitrary numbers."
